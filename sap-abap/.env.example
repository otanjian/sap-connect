# Used only for npm run discover-tools (catalog generation), not as a shared live chat connection.
SAP_HOST=sap.example.com
SAP_PORT=44300
SAP_USER=DEVELOPER
SAP_PASSWORD=your-password
SAP_CLIENT=200
SAP_HTTPS=1
SAP_INSECURE=1
SAP_TIMEOUT=60

# erpl-adt binary (optional if on PATH)
# ERPL_ADT=/Users/you/.local/bin/erpl-adt

# BuildingAI HTTP gateway
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_PATH=/mcp
MCP_TRANSPORT=streamableHttp

# Multi-user connection registry
MAX_CONNECTIONS=20
IDLE_TTL_MS=1800000
