  {
    "name": "bw_search",
    "description": "Search the BW repository for modeling objects (ADSO, IOBJ, HCPR, TRFN, etc.). Use wildcards (*). Returns object names, types, statuses, and URIs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "changed_by": {
          "description": "Filter by last changed user",
          "type": "string"
        },
        "changed_on_from": {
          "description": "Changed on or after date",
          "type": "string"
        },
        "changed_on_to": {
          "description": "Changed on or before date",
          "type": "string"
        },
        "created_by": {
          "description": "Filter by creator",
          "type": "string"
        },
        "created_on_from": {
          "description": "Created on or after date",
          "type": "string"
        },
        "created_on_to": {
          "description": "Created on or before date",
          "type": "string"
        },
        "depends_on_name": {
          "description": "Filter by dependency object name",
          "type": "string"
        },
        "depends_on_type": {
          "description": "Filter by dependency object type",
          "type": "string"
        },
        "max_results": {
          "description": "Maximum results (default: 100)",
          "type": "integer"
        },
        "object_sub_type": {
          "description": "Filter by subtype (e.g., REP, SOB, RKF)",
          "type": "string"
        },
        "object_type": {
          "description": "Filter by type: ADSO, HCPR, IOBJ, TRFN, DTPA, RSDS",
          "type": "string"
        },
        "query": {
          "description": "Search pattern with wildcards (e.g., Z*, *SALES*)",
          "type": "string"
        },
        "search_in_description": {
          "description": "Also search in descriptions",
          "type": "boolean"
        },
        "status": {
          "description": "Filter by status: ACT, INA, OFF",
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "bw_read_object",
