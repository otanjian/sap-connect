[
  {
    "name": "adt_search",
    "description": "Search the ABAP repository for objects by name pattern. Use wildcards (*). Returns object URIs needed for all other operations.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "max_results": {
          "description": "Maximum number of results (default: 100)",
          "type": "integer"
        },
        "object_type": {
          "description": "Filter by type: CLAS, PROG, TABL, INTF, FUGR",
          "type": "string"
        },
        "query": {
          "description": "Search pattern with wildcards (e.g., ZCL_*)",
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "adt_read_object",
    "description": "Read metadata and structure of an ABAP object. Returns name, type, source URIs, includes, and version info.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "uri": {
          "description": "Object URI (e.g., /sap/bc/adt/oo/classes/zcl_example)",
